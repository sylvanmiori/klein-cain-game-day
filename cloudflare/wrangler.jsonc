{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gameday-report",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "assets": {
    "directory": "../dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    { "binding": "SCORES", "id": "230ad4e9643a45b7b9e7a9a88ca3db6a" }
  ],
  // Workers AI binding used by the 4:13 Baseball box-score screenshot parser
  // (POST /api/baseball/boxscore) in worker.mjs.
  "ai": { "binding": "AI" },
  // D1 database for 4:13 Baseball box-score stats (created 2026-09-26).
  // Binding name must stay BASEBALL_STATS — worker.mjs reads env.BASEBALL_STATS.
  "d1_databases": [
    {
      "binding": "BASEBALL_STATS",
      "database_name": "413baseball-stats",
      "database_id": "8885adde-6929-40f8-906d-bef5479729cf"
    }
  ],
  "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "gameday.report", "custom_domain": true },
    { "pattern": "kleincain.gameday.report", "custom_domain": true },
    { "pattern": "413baseball.gameday.report", "custom_domain": true }
  ]
}
